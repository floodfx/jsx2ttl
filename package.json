{
  "name": "jsx2ttl",
  "version": "0.3.0",
  "description": "Convert JSX to tagged template literal",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floodfx/jsx2ttl.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4"
  },
  "scripts": {
    "test": "bun test",
    "build": "rm -rf dist && bun run build.ts && bun x tsc --noEmit false --declaration --emitDeclarationOnly --skipLibCheck --outDir dist && cp dist/src/index.d.ts dist/index.d.ts",
    "direct": "rm -rf out && bun run src/direct_build.ts",
    "prepare": "bun run build"
  },
  "author": "Donnie Flood <donnie@floodfx.com>",
  "license": "MIT"
}
